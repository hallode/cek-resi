    {
      "name": "1001 g bills 2 kg",
      "request": {
        "method": "GET",
        "path": "/api/ongkir?origin=JKT&destination=BDG&weight=1001"
      },
      "expect": {
        "status": 200,
        "body": {
          "billable_weight_kg": 2
        }
      }
    },
    {
      "name": "1000 g bills 1 kg",
      "request": {
        "method": "GET",
        "path": "/api/ongkir?origin=JKT&destination=BDG&weight=1000"
      },
      "expect": {
        "status": 200,
        "body": {
          "billable_weight_kg": 1
        }
      }
    },
    {
      "name": "actual weight beats smaller volumetric",
      "request": {
        "method": "GET",
        "path": "/api/ongkir?origin=JKT&destination=BDG&weight=5000&length=10&width=10&height=10"
      },
      "expect": {
        "status": 200,
        "body": {
          "billable_weight_kg": 5
        }
