    },
    {
      "name": "max weight",
      "request": {
        "method": "GET",
        "path": "/api/ongkir?origin=JKT&destination=MKS&weight=50000"
      },
      "expect": {
        "status": 200,
        "body": {
          "billable_weight_kg": 50,
          "options": {
            "$length": 7
          }
        }
      }
    },
    {
      "name": "missing weight",
      "request": {
        "method": "GET",
        "path": "/api/ongkir?origin=JKT&destination=BDG"
      },
      "expect": {
        "status": 400,
        "body": {
          "error": "parameter origin, destination, dan weight wajib diisi"
        }
      }
    },
    {
      "name": "unknown origin",
      "request": {
        "method": "GET",
        "path": "/api/ongkir?origin=XXX&destination=BDG&weight=1000"
